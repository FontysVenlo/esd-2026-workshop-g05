@baseUrl = http://localhost:4000

# Expected names below assume a fresh server start.
### 200: p1 (Evening Coding; t1, t2) and p2 (Morning Walk; t2), each with id, name and trackIds.
GET {{baseUrl}}/playlists

### 200: p1 embeds Quiet Lines and River Lights; p2 embeds River Lights. Each track embeds Mira Vale (a1).
### Compare with PlaylistList in queries.graphql. REST also includes trackIds, durationSeconds and artistId.
GET {{baseUrl}}/playlists?include=tracks.artist

### 400: { "error": "Use include=tracks.artist exactly once" }
GET {{baseUrl}}/playlists?include=tracks

### 200: { "id": "p1", "name": "Evening Coding", "trackIds": ["t1", "t2"] }
GET {{baseUrl}}/playlists/p1

### 200: { "id": "t1", "title": "Quiet Lines", "durationSeconds": 180, "artistId": "a1" }
GET {{baseUrl}}/tracks/t1

### 200: { "id": "t2", "title": "River Lights", "durationSeconds": 210, "artistId": "a1" }
GET {{baseUrl}}/tracks/t2

### Both tracks reference this artist; fetch once and reuse.
### 200: { "id": "a1", "name": "Mira Vale" }
GET {{baseUrl}}/artists/a1

### 404: { "error": "Not found" }
GET {{baseUrl}}/playlists/unknown

### 404: { "error": "Not found" }
GET {{baseUrl}}/tracks/unknown

### 404: { "error": "Not found" }
GET {{baseUrl}}/artists/unknown
